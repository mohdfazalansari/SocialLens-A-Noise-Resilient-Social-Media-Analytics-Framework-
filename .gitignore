# SocialLens Monorepo .gitignore

# Java / Spring Boot
backend/target/
backend/.mvn/
backend/*.iml
backend/.project
backend/.classpath
backend/.settings/

# Environment & Secrets
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.jks
*.p12

# Python / FastAPI
ai-service/__pycache__/
ai-service/*/__pycache__/
ai-service/*/*/__pycache__/
ai-service/*.pyc
ai-service/.pytest_cache/
ai-service/venv/
ai-service/.env
*.pyc
__pycache__/

# Node / React
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
frontend/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Storage / Uploads / Logs
uploads/
logs/
*.log
~$*
*.tmp
*.bak
desktop.ini

